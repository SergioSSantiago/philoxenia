{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build -w @philoxenia/shared && npm run build -w @philoxenia/api",
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
